# ============================================================================
# 🇰🇷 대한민국 특일·절기·기념일 스마트 캘린더 허브 (korea_calendar) 환경변수 설정 예시
# ============================================================================

# 1. 공공데이터포털 [승인] 한국천문연구원_특일 정보 (SpcdeInfoService)
# - 비워두셔도 내장 한국천문연구원(KASI) 역서 계산 엔진으로 100% 정상 동작합니다.
# - 웹 대시보드 우측 상단 [🔑 공공데이터포털 API 설정] 버튼에서도 바로 입력/저장할 수 있습니다.
# - Encoding 인증키 / Decoding 인증키 모두 자동으로 판별하여 호환됩니다.
DATA_GO_KR_SERVICE_KEY=
KASI_APPLIED_DATE=2026-05-14
KASI_EXPIRE_DATE=2028-05-14

# 2. 서버 바인딩 및 자동 동기화 주기 설정
KOREA_CAL_HOST=0.0.0.0
KOREA_CAL_PORT=8500
KOREA_CAL_EXTERNAL_PORT=38503
KOREA_CAL_AUTO_SYNC_MINUTES=720
KOREA_CAL_START_YEAR=2020
KOREA_CAL_END_YEAR=2032

# 3. 시놀로지 NAS / 리눅스 권한 설정 (기본값: 시놀로지 PUID=1026, PGID=100)
PUID=1026
PGID=100

# 4. (선택) Cloudflare Tunnel 토큰 (compose.cloudflare.yml 사용 시)
CLOUDFLARE_TUNNEL_TOKEN=
